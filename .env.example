DATABASE_MODE=sqlite
# Set DATABASE_MODE=postgres and uncomment this after creating the database.
# DATABASE_URL=postgresql://commera2:REPLACE_WITH_YOUR_PASSWORD@localhost:5432/commera2
PIXEL_CREDENTIALS_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
OTP_CREDENTIALS_SECRET=REPLACE_WITH_A_DIFFERENT_32_CHARACTER_SECRET

# Google merchant sign-in. Create a Google OAuth client of type Web application.
# Local redirect: http://localhost:4173/api/auth/google/callback
# Render redirect: https://commera2.onrender.com/api/auth/google/callback
APP_BASE_URL=http://localhost:4173
# GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
# AUTH_OAUTH_STATE_SECRET=REPLACE_WITH_ANOTHER_RANDOM_32_CHARACTER_SECRET
# Override only when the callback differs from APP_BASE_URL.
# GOOGLE_REDIRECT_URI=http://localhost:4173/api/auth/google/callback
DOMAIN_PLATFORM_HOST=shops.commera2.app
# Set the actual CNAME destination supplied by your hosting provider.
# Custom domain setup is blocked while this is empty.
DOMAIN_CNAME_TARGET=
# Set this when the hosting provider requires an A record for apex domains.
# DOMAIN_APEX_TARGET=192.0.2.1
DOMAIN_PROVIDER=manual
# On Render, HTTPS verification is enabled automatically. Set this to "https"
# only when hosting elsewhere and after its TLS certificate is managed there.
# DOMAIN_SSL_PROVIDER=https
DOMAIN_SYNC_INTERVAL_MS=60000

# Twilio Verify OTP. Keep real credentials only in the ignored .env.otp file.
# TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_API_KEY_SECRET=replace-with-api-key-secret
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=replace-with-auth-token
# TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
